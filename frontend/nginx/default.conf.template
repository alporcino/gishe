# Gishe ön yüz sunucusu. Bu şablondaki ${BACKEND_URL} konteyner açılırken ortam değişkeninden doldurulur.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;

    # API istekleri arka uca iletilir (tarayıcı için aynı adres, CORS sorunu olmaz)
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;   # yapay zekâ CPU'da çalıştığı için uzun cevaplara izin ver
    }

    # Arka ucun durumu ön yüz adresinden de görülebilsin
    location = /health {
        proxy_pass ${BACKEND_URL}/health;
    }

    # Ortam değişkeninden üretilen ayar dosyası önbelleğe alınmaz
    location = /config.js {
        add_header Cache-Control "no-store";
    }

    location ~* \.(css|js)$ {
        expires 7d;
        add_header Cache-Control "public";
    }

    location / {
        try_files $uri $uri/ =404;
    }

    error_page 404 /giris.html;
}
