# Gishe ayarları. Bu dosyayı ".env" adıyla kopyalayıp değerleri değiştirebilirsiniz.
# .env dosyası depoya EKLENMEZ (.gitignore). Hiçbir ayar zorunlu değildir; boş bırakılan varsayılanı kullanır.

# ---- Portlar (bilgisayarınızda doluysa değiştirin)
FRONTEND_PORT=3000
API_PORT=8000

# ---- Yapay zekâ modeli (Ollama kütüphanesinden açık kaynak model)
# qwen2.5:3b   -> daha iyi Türkçe, CPU'da cevap ~10-40 sn
# qwen2.5:1.5b -> daha hızlı, cevaplar daha basit
# Değiştirdikten sonra: docker compose up --build
MODEL=qwen2.5:3b
MODEL_ZAMAN_ASIMI=120
MODEL_EN_FAZLA_TOKEN=220

# ---- Ön yüzün API adresi
# Boş bırakılırsa arayüz kendi adresini kullanır, nginx /api isteklerini arka uca iletir (önerilen).
# Doğrudan bağlanmak için örnek: API_URL=http://localhost:8000
API_URL=

# ---- API'ye tarayıcıdan doğrudan erişebilecek adresler (CORS), virgülle ayrılır
CORS_KAYNAKLARI=http://localhost:3000,http://127.0.0.1:3000

# ---- Oturum
OTURUM_SAAT=12
# HTTPS arkasında yayınlanırsa true yapın
GUVENLI_CEREZ=false

# ---- Demo modu: giriş ekranında örnek hesaplar ve şifresiz demo girişi
# docker compose ile varsayılan olarak AÇIKTIR (sunum için). Gerçek kullanımda false yapın.
# Uygulama docker compose dışında çalıştırılırsa varsayılan KAPALIDIR.
DEMO_MODU=true
# Demo hesaplarına e-posta/şifreyle de girmek isterseniz bir şifre belirleyin.
# Boş bırakılırsa her kurulumda rastgele üretilir (depoda şifre tutulmaz).
DEMO_SIFRE=

# ---- Giriş güvenliği: bir hesaba bu kadar hatalı şifre girilirse hesap bu kadar dakika kilitlenir
GIRIS_DENEME_SINIRI=10
GIRIS_KILIT_DAKIKA=15

# ---- Hedef süre hesabında iş günü sayılmayacak ek günler (idari izin vb.). Resmî tatiller zaten sayılmaz.
# Virgülle, YYYY-AA-GG biçiminde. Örnek: EK_TATILLER=2026-10-30,2027-05-20
EK_TATILLER=

# ---- E-posta bildirimi (isteğe bağlı). Boş bırakılırsa e-posta gönderilmez; uygulama içindeki
# "Yeni gelişme" işaretleri yine çalışır. E-postada mesaj içeriği yer almaz, sadece talep no ve bağlantı.
SMTP_SUNUCU=
SMTP_PORT=587
SMTP_KULLANICI=
SMTP_SIFRE=
SMTP_GONDEREN=
# starttls | ssl | yok
SMTP_GUVENLIK=starttls
# E-postadaki bağlantı (kullanıcıların uygulamayı açtığı adres)
UYGULAMA_URL=http://localhost:3000

# ---- Sonuçlanan talep kaç gün içinde "çözülmedi" diyerek yeniden açılabilir
YENIDEN_ACMA_GUN=30
